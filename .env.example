# Copy to .env and adjust as needed. Nothing here is required for the demo —
# every value below has a sane default baked into backend/config.py — but a
# real deployment would set these explicitly rather than rely on defaults.

# --- Database ---
# SQLite by default. See backend/db.py for the documented path to swapping
# this for a real Postgres connection string (SQLAlchemy engine URL) —
# connection-string swap only, no code changes needed elsewhere.
DATABASE_URL=sqlite:///./data/revenue_recovery.db

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Policy / decision engine ---
COOLDOWN_HOURS=24
MAX_ATTEMPTS=3
SAFETY_ITERATION_CAP=6

# --- ML model paths ---
MODEL_PATH=models/recovery_model.pkl
MODEL_METADATA_PATH=models/model_metadata.json
MODEL_SCALER_PATH=models/feature_scaler.pkl

# --- Rate limiting (api.py /api/run-batch) ---
RUN_BATCH_RATE_LIMIT_MAX=3
RUN_BATCH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Payment execution (see backend/execution.py's PaymentExecutor seam) ---
# UNUSED TODAY — everything is mocked (MockExecutor). This is wired for a
# real Razorpay integration tomorrow, not implemented now. Do not put a real
# key in .env.example; put it only in your local, gitignored .env if/when a
# RazorpayExecutor is actually implemented.
RAZORPAY_API_KEY=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_EXECUTOR=mock
